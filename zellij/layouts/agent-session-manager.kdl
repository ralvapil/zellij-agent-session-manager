layout {
    default_tab_template {
        pane split_direction="vertical" {
            pane size=28 borderless=true name="agent-sidebar" {
                plugin location="zellij-agent-session-manager"
            }
            children
        }
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
    }

    new_tab_template {
        pane split_direction="vertical" {
            pane size=28 borderless=true name="agent-sidebar" {
                plugin location="zellij-agent-session-manager"
            }
            pane focus=true
        }
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
    }

    tab name="main" {
        pane focus=true
    }
}
